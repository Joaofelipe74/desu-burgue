# Copie este arquivo para ".env" e ajuste. O ".env" NÃO deve ir para o Git.

# development (padrão) ou production
NODE_ENV=development

# Porta do servidor
PORT=3000

# Endereço público do site. Em produção é OBRIGATÓRIO e precisa ser https://
# PUBLIC_ORIGIN=https://www.seudominio.com.br

# Endereço de escuta (padrão: 127.0.0.1 em desenvolvimento, 0.0.0.0 em produção)
# HOST=0.0.0.0

# Quantos proxies reversos (ex.: Nginx, Cloudflare, hospedagem) ficam na frente do app.
# Deixe 0 se o Node recebe as conexões diretamente.
TRUST_PROXY=0

# HTTPS direto no Node (opcional; normalmente a hospedagem/proxy cuida disso)
# TLS_CERT_FILE=/caminho/certificado.pem
# TLS_KEY_FILE=/caminho/chave.pem

# Pasta de dados (banco e imagens enviadas). Padrão: ./data
# DATA_DIR=./data

# Sessão do painel: duração máxima (horas) e inatividade (minutos)
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# Tamanho máximo de imagem enviada (MB)
MAX_IMAGE_MB=5
